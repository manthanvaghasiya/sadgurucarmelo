# ──────────────────────────────────────────────
# Sadguru Car Melo — Backend Environment Config
# ──────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://SADGURU:sadgurucarmelo@clustero.mvlqdam.mongodb.net/?appName=Clustere

# JWT
JWT_SECRET=sadguru_super_secret_key_change_in_production
JWT_EXPIRE=7d

# ──────────────────────────────────────────────
# Primary Media Storage — ImageKit.io (20 GB Free Tier)
# Get credentials from: https://imagekit.io/dashboard/developer/api-keys
# ──────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ──────────────────────────────────────────────
# Standby Backup Storage — Cloudflare R2 (Optional zero egress overflow)
# ──────────────────────────────────────────────
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=sadguru-cars
# R2_PUBLIC_DOMAIN=https://media.sadgurucarmelo.com

# Google Places API
GOOGLE_PLACE_ID=ChIJ5bS_6N1P4DsR3GQoB2TdSoM
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY_HERE

# CORS — Frontend URL (used for production CORS origin)
FRONTEND_URL=https://sadgurucarmelo.com

# Webhook — n8n / automation (optional, for lead forwarding)
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxx
